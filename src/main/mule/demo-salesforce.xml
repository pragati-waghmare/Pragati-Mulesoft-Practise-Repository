				</ee:message>
			</ee:transform>
			<set-variable value="#[output application/json&#10;---&#10;vars.resultVar + (payload)]" doc:name="Set Variable" doc:id="34c092f6-a841-4dff-8f0d-e04ff1922f4a" variableName="resultVar" />
